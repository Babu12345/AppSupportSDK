generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  passwordHash  String?
  googleId      String?  @unique
  githubId      Int?     @unique
  githubToken   String?
  name          String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  subscriptionTier     String  @default("free")
  stripeCustomerId     String? @unique
  stripeSubscriptionId String? @unique
  hasUsedTrial         Boolean @default(false)

  organizations Organization[]
  chatEvents    ChatEvent[]
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  apiKey    String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  knowledge     KnowledgeSource[]
  conversations Conversation[]
  chatEvents    ChatEvent[]
}

model KnowledgeSource {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  title          String
  content        String       // The actual knowledge content (markdown)
  sourceType     String       // "manual", "url", "file", "github"
  sourceUrl      String?      // Original URL if scraped
  sourceConfig   String?      // JSON config for source-specific options (e.g., GitHub content toggles)

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model Conversation {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  sessionId      String       // Client-generated session ID
  messages       Message[]

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])

  role           String       // "user" or "assistant"
  content        String
  source         String?      // "cloud", "on-device"

  createdAt      DateTime     @default(now())
}

model ChatEvent {
  id             String       @id @default(cuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id])
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])
  createdAt      DateTime     @default(now())

  @@index([userId, createdAt])
  @@index([organizationId, createdAt])
}
